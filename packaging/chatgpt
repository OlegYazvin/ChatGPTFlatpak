export TMPDIR="${XDG_RUNTIME_DIR:?}/app/${FLATPAK_ID:?}"
mkdir -p "$TMPDIR"
export PATH="/app/extra/chatgpt/resources/cua_node/bin:/app/extra/chatgpt/resources:$PATH"
